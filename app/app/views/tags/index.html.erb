<% content_for :title, "Weigh tags — WeighTags" %>
<%= turbo_stream_from "org_#{current_org.id}_loads" %>
<% field = field_class(:filter) %>

<div class="py-6 px-4 sm:px-6">
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
    <div>
      <h1 class="text-2xl font-medium mb-1">Weigh tags</h1>
      <p class="text-sm text-muted-foreground">Reconciliation dashboard for <%= current_org.name %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <%= link_to "Mark invoiced", new_invoice_batch_path, class: btn_class(:secondary, size: :md) %>
      <%= link_to "Import CSV", new_csv_import_path, class: btn_class(:secondary, size: :md) %>
      <%= link_to "Add weigh tag", new_weigh_path, class: btn_class(:primary, size: :md) %>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <% [
      ["Pending partner", @stats[:pending], ""],
      ["Needs review",    @stats[:review],   "text-status-review"],
      ["Disputed",        @stats[:disputed], "text-status-disputed"],
      ["Matched",         @stats[:matched],  "text-status-matched"]
    ].each do |label, value, color| %>
      <div class="bg-card border border-border rounded-lg p-4">
        <div class="text-xs text-muted-foreground mb-1"><%= label %></div>
        <div class="text-2xl font-medium tabular-nums <%= color %>"><%= value %></div>
      </div>
    <% end %>
  </div>

  <% if @tags.none? && request.query_parameters.except("status").empty? && params[:status].blank? %>
    <%= render "empty_state" %>
  <% else %>
    <%= form_with url: tags_path, method: :get, data: { turbo_frame: "_top" }, class: "bg-card border border-border rounded-lg mb-4" do %>
      <div class="p-4 grid grid-cols-2 md:grid-cols-6 gap-3 items-end">
        <div class="col-span-2 md:col-span-2">
          <label class="block text-xs text-muted-foreground mb-1">Search BOL / truck / driver</label>
          <%= search_field_tag :q, params[:q], class: "#{field} w-full" %>
        </div>
        <div>
          <label class="block text-xs text-muted-foreground mb-1">Status</label>
          <%= select_tag :status,
                options_for_select([["All statuses", "all"]] + ::Tags::Query::STATUS_OPTIONS, params[:status].presence || "all"),
                class: "#{field} w-full" %>
        </div>
        <div>
          <label class="block text-xs text-muted-foreground mb-1">Partner</label>
          <%= select_tag :partner_id,
                options_from_collection_for_select(@partners, :id, :name, params[:partner_id]),
                include_blank: "All partners", class: "#{field} w-full" %>
        </div>
        <div>
          <label class="block text-xs text-muted-foreground mb-1">Ship from</label>
          <%= date_field_tag :from, params[:from], class: "#{field} w-full" %>
        </div>
        <div>
          <label class="block text-xs text-muted-foreground mb-1">Ship to</label>
          <%= date_field_tag :to, params[:to], class: "#{field} w-full" %>
        </div>
        <div class="col-span-2 md:col-span-2">
          <label class="block text-xs text-muted-foreground mb-1">Invoice number</label>
          <%= search_field_tag :invoice_number, params[:invoice_number], class: "#{field} w-full" %>
        </div>
        <div class="col-span-2 md:col-span-4 flex items-center gap-2">
          <%= submit_tag "Apply", class: btn_class(:primary) %>
          <%= link_to "Clear", tags_path, class: "px-3 py-1.5 text-sm rounded-md border border-border" %>
          <%= link_to "Export CSV", tags_path(request.query_parameters.merge(format: :csv)),
                class: "px-3 py-1.5 text-sm rounded-md border border-border ml-auto" %>
        </div>
      </div>

      <div class="border-t border-border px-4 py-2.5 flex flex-wrap items-center gap-x-6 gap-y-1 text-sm bg-secondary/30">
        <span class="text-muted-foreground"><%= pluralize(@aggregates[:count], "weigh tag") %></span>
        <span><span class="text-muted-foreground">Your gross</span> <span class="font-mono tabular-nums"><%= lb(@aggregates[:gross]) %> lb</span></span>
        <span><span class="text-muted-foreground">Your tare</span> <span class="font-mono tabular-nums"><%= lb(@aggregates[:tare]) %> lb</span></span>
        <span><span class="text-muted-foreground">Your net</span> <span class="font-mono tabular-nums font-medium"><%= lb(@aggregates[:net]) %> lb</span></span>
      </div>
    <% end %>

    <div class="bg-card border border-border rounded-lg overflow-x-auto">
      <% if @tags.none? %>
        <div class="p-10 text-center text-sm text-muted-foreground">No weigh tags match these filters.</div>
      <% else %>
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-secondary/60 text-left">
              <th class="<%= th_class %>">BOL</th>
              <th class="<%= th_class %>">Ship date</th>
              <th class="<%= th_class %>">Commodity</th>
              <th class="<%= th_class %>">Sender</th>
              <th class="<%= th_class %>">Receiver</th>
              <th class="<%= th_class %>">Truck</th>
              <th class="<%= th_class(:right) %>">Sender net (lb)</th>
              <th class="<%= th_class(:right) %>">Receiver net (lb)</th>
              <th class="<%= th_class(:right) %>">Δ</th>
              <th class="<%= th_class %>">Status</th>
            </tr>
          </thead>
          <tbody>
            <%= render @tags %>
          </tbody>
        </table>
      <% end %>
    </div>
  <% end %>
</div>
