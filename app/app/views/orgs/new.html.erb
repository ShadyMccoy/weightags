<% content_for :title, "New organization — WeighTags" %>

<div class="max-w-md mx-auto px-6 py-16">
  <h1 class="text-2xl font-medium mb-1">Create an organization</h1>
  <p class="text-sm text-muted-foreground mb-6">A persistent business entity that holds your weigh-tag history.</p>

  <%= render "shared/errors", model: @org %>

  <%= form_with url: orgs_path, scope: :org, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, "Organization name", class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :name, required: true, autofocus: true,
            class: "w-full px-3 py-2 rounded-md bg-input-background border border-border" %>
    </div>
    <%= f.submit "Create organization", class: "w-full #{btn_class(:primary, size: :lg)}" %>
  <% end %>
</div>
