<% content_for :title, "Get started — WeighTags" %>

<div class="max-w-md mx-auto px-6 py-12">
  <h1 class="text-2xl font-medium mb-1">Create your account</h1>
  <p class="text-sm text-muted-foreground mb-6">
    You'll set up your organization too — you become its first admin.
  </p>

  <%= render "shared/errors", model: @user %>

  <%= form_with url: sign_up_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, "Your name", class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :name, value: @user.name, required: true,
            class: "w-full px-3 py-2 rounded-md bg-input-background border border-border" %>
    </div>
    <div>
      <%= f.label :email_address, "Email", class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email_address, value: @user.email_address, required: true, autocomplete: "username",
            class: "w-full px-3 py-2 rounded-md bg-input-background border border-border" %>
    </div>
    <div>
      <%= label_tag :org_name, "Organization name", class: "block text-sm font-medium mb-1" %>
      <%= text_field_tag :org_name, @org_name, required: true,
            class: "w-full px-3 py-2 rounded-md bg-input-background border border-border" %>
    </div>
    <div>
      <%= f.label :password, "Password", class: "block text-sm font-medium mb-1" %>
      <%= f.password_field :password, required: true, autocomplete: "new-password",
            class: "w-full px-3 py-2 rounded-md bg-input-background border border-border" %>
    </div>
    <%= f.submit "Create account", class: "w-full #{btn_class(:primary, size: :lg)}" %>
  <% end %>

  <p class="mt-4 text-sm text-muted-foreground">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "hover:text-foreground underline" %>
  </p>
</div>
