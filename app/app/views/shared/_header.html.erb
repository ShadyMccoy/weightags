<header class="border-b border-border bg-card sticky top-0 z-10">
  <div class="px-4 sm:px-6 py-4 flex items-center justify-between gap-2 sm:gap-4">
    <%= link_to (authenticated? ? tags_path : root_path), class: "flex items-center gap-2 shrink-0" do %>
      <svg class="h-6 w-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z" opacity=".0"/><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
      <div>
        <div class="text-lg font-medium leading-tight">WeighTags</div>
        <div class="text-xs text-muted-foreground leading-tight hidden sm:block">Commodity Weigh Tag Reconciliation</div>
      </div>
    <% end %>

    <% if authenticated? && Current.org %>
      <div class="flex items-center gap-2 sm:gap-4 min-w-0">
        <%= form_with url: tags_path, method: :get, class: "relative w-72 hidden md:block" do |f| %>
          <svg class="absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <%= f.search_field :q, value: params[:q], placeholder: "Search by BOL, truck, driver…",
                class: "w-full pl-9 pr-3 py-2 text-sm rounded-md bg-input-background border border-border focus:outline-none focus:ring-2 focus:ring-muted" %>
        <% end %>

        <%= render "shared/org_switcher" %>

        <div class="text-right text-sm hidden sm:block">
          <div class="font-medium leading-tight"><%= Current.user.display_name %></div>
          <div class="text-xs text-muted-foreground leading-tight"><%= Current.user.email_address %></div>
        </div>
        <%= button_to session_path, method: :delete, class: "text-xs text-muted-foreground hover:text-foreground" do %>
          Sign out
        <% end %>
      </div>
    <% elsif !authenticated? %>
      <div class="flex items-center gap-3 text-sm">
        <%= link_to "Sign in", new_session_path, class: "text-muted-foreground hover:text-foreground" %>
        <%= link_to "Get started", sign_up_path,
              class: btn_class(:primary) %>
      </div>
    <% end %>
  </div>
</header>
