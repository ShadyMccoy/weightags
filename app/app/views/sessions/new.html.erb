<% content_for :title, "Sign in — WeighTags" %>

<div class="max-w-sm mx-auto px-6 py-16">
  <h1 class="text-2xl font-medium mb-1">Sign in</h1>
  <p class="text-sm text-muted-foreground mb-6">Welcome back to your shared record.</p>

  <%= form_with url: session_path, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "block text-sm font-medium mb-1" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address],
            class: "w-full px-3 py-2 rounded-md bg-input-background border border-border focus:outline-none focus:ring-2 focus:ring-muted" %>
    </div>
    <div>
      <%= form.label :password, "Password", class: "block text-sm font-medium mb-1" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: "w-full px-3 py-2 rounded-md bg-input-background border border-border focus:outline-none focus:ring-2 focus:ring-muted" %>
    </div>
    <%= form.submit "Sign in", class: "w-full #{btn_class(:primary, size: :lg)}" %>
  <% end %>

  <div class="flex items-center justify-between mt-4 text-sm text-muted-foreground">
    <%= link_to "Forgot password?", new_password_path, class: "hover:text-foreground" %>
    <%= link_to "Create an account", sign_up_path, class: "hover:text-foreground" %>
  </div>
</div>
