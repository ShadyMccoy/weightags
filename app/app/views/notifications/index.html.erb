<% content_for :title, "Notifications — WeighTags" %>

<div class="py-6 px-6 max-w-3xl mx-auto">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-medium mb-1">Notifications</h1>
      <p class="text-sm text-muted-foreground">Events on your weigh tags in <%= current_org.name %>.</p>
    </div>
    <% if @notifications.any? { |n| !n.read? } %>
      <%= button_to "Mark all read", read_all_notifications_path, class: "px-3 py-1.5 text-sm rounded-md border border-border" %>
    <% end %>
  </div>

  <div class="bg-card border border-border rounded-lg divide-y divide-border">
    <% @notifications.each do |n| %>
      <%= button_to notification_path(n), method: :patch,
            class: "w-full text-left px-4 py-3 hover:bg-secondary/40 flex items-start gap-3 #{'bg-status-pending/5' unless n.read?}" do %>
        <span class="mt-1 h-2 w-2 rounded-full <%= n.read? ? 'bg-transparent' : 'bg-status-pending' %>"></span>
        <span class="flex-1">
          <span class="block text-sm font-medium"><%= n.title %></span>
          <span class="block text-sm text-muted-foreground"><%= n.body %></span>
          <span class="block text-xs text-muted-foreground mt-0.5 tabular-nums"><%= fmt_datetime(n.created_at) %></span>
        </span>
      <% end %>
    <% end %>
    <% if @notifications.empty? %>
      <div class="px-4 py-10 text-center text-sm text-muted-foreground">Nothing yet.</div>
    <% end %>
  </div>
</div>
