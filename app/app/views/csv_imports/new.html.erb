<% content_for :title, "Import CSV — WeighTags" %>
<% field = "#{field_class} w-full" %>

<div class="py-6 px-6 max-w-3xl mx-auto">
  <div class="mb-4">
    <%= link_to tags_path, class: "text-sm text-muted-foreground hover:text-foreground" do %>← Back to weigh tags<% end %>
  </div>
  <h1 class="text-2xl font-medium mb-1">Import weigh tags from CSV</h1>
  <p class="text-sm text-muted-foreground mb-6">
    You'll see a validation preview before anything is committed. Rejected rows
    come back as a downloadable error report.
  </p>

  <%= form_with url: csv_imports_path, method: :post, multipart: true,
        class: "space-y-5 bg-card border border-border rounded-lg p-6" do %>
    <%= render "shared/partner_picker", partners: @partners %>
    <div>
      <label class="block text-sm font-medium mb-1">CSV file</label>
      <%= file_field_tag :file, accept: ".csv,text/csv", required: true, class: field %>
    </div>
    <%= submit_tag "Preview import", class: btn_class(:primary, size: :lg) %>
  <% end %>

  <div class="mt-6 bg-card border border-border rounded-lg p-5 text-sm">
    <h2 class="font-medium mb-2">Expected columns</h2>
    <p class="text-muted-foreground mb-3">
      Header names are matched loosely (case and spacing don't matter).
      <strong>bol</strong> is required; a net weight (or gross + tare) is required.
    </p>
    <code class="block font-mono text-xs bg-secondary rounded p-3 overflow-x-auto">
      <%= Csv::WeighImport::COLUMNS.keys.join(", ") %>
    </code>
  </div>
</div>
