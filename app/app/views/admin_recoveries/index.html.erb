<% content_for :title, "Admin recovery — WeighTags" %>

<div class="py-6 px-6 max-w-2xl mx-auto">
  <h1 class="text-2xl font-medium mb-1">Admin recovery</h1>
  <p class="text-sm text-muted-foreground mb-6">
    Organizations on your email domain (<span class="font-mono"><%= Current.user.email_address.split("@").last %></span>)
    that have verified their domain. You can claim admin access if you've been locked out.
  </p>

  <% if @orgs.empty? %>
    <div class="bg-card border border-border rounded-lg p-10 text-center text-sm text-muted-foreground">
      No domain-verified organizations on your email domain need recovery.
    </div>
  <% else %>
    <div class="bg-card border border-border rounded-lg divide-y divide-border">
      <% @orgs.each do |org| %>
        <div class="px-4 py-3 flex items-center justify-between">
          <div>
            <div class="font-medium"><%= org.name %></div>
            <div class="text-xs text-muted-foreground font-mono"><%= org.domain %></div>
          </div>
          <%= button_to "Recover admin", admin_recoveries_path, params: { org_id: org.id },
                class: btn_class(:primary) %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
