# Secrets are looked up by Kamal at deploy time and injected as env vars.
# These reference your local environment / a secrets manager — never commit
# real values. See https://kamal-deploy.org/docs/commands/secrets.

# Registry auth.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Decrypts config/credentials.yml.enc.
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Postgres credentials (shared by the app and the db accessory).
WEIGHTAGS_DB_PASSWORD=$WEIGHTAGS_DB_PASSWORD
POSTGRES_PASSWORD=$WEIGHTAGS_DB_PASSWORD
