{
  "schema": "bittergrid.repo_manifest.v1",
  "runtime": {
    "kind": "rails",
    "default_process": "web",
    "processes": {
      "web": {
        "start_command": "bin/thrust bin/rails server -b 0.0.0.0 -p 80",
        "container_port": 80,
        "health_path": "/up"
      }
    }
  },
  "build": {
    "dockerfile": "app/Dockerfile",
    "context": "app"
  },
  "database": {
    "kind": "postgres",
    "env": "DATABASE_URL",
    "schema_source": "app/db/schema.rb"
  },
  "migrations": {
    "command": "cd /rails && SECRET_KEY_BASE_DUMMY=1 bin/rails db:migrate",
    "schema_source": "app/db/schema.rb"
  },
  "deploy": {
    "services": {
      "web": {
        "start_command": "bin/thrust bin/rails server -b 0.0.0.0 -p 80",
        "container_port": 80,
        "health_path": "/up"
      }
    }
  }
}
